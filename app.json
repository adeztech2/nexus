{
  "name": "Nexus",
  "description": "Nexus WhatsApp bot by Arnold Adez (ADEZ TECH)",
  "repository": "https://github.com/adeztech2/nexus",
  "keywords": [
    "whatsapp",
    "bot",
    "nodejs"
  ],
  "stack": "container",
  "env": {
    "SESSION_ID": {
      "description": "Session ID from the /pair page (starts with NEXUS~)",
      "required": true
    },
    "OWNER_NUMBER": {
      "description": "Extra owner numbers (digits only). Arnold Adez 254111783552 is always the main owner.",
      "value": "254111783552",
      "required": false
    },
    "SESSION_DIR": {
      "value": "/tmp/session"
    },
    "BOT_NAME": {
      "value": "Nexus"
    },
    "PREFIX": {
      "value": "."
    },
    "MODE": {
      "value": "public"
    },
    "TIMEZONE": {
      "value": "Africa/Nairobi"
    },
    "AUTO_VIEW_STATUS": {
      "value": "true"
    },
    "CONNECT_ALERT": {
      "value": "true"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
}

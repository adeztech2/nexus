# Nexus configuration. Copy values into your host's environment variables if you deploy.
BOT_NAME=Nexus
PREFIX=.
# Your WhatsApp number, digits only with country code (comma separate for several owners)
OWNER_NUMBER=
# public or private
MODE=public
# Your number again (digits only) to log in with a pairing code. Leave empty to use a QR code.
PAIRING_NUMBER=
# Paste the session ID the bot sends you after the first link (starts with NEXUS~).
# With it set, the bot logs in without a QR/pairing code, ideal for Render/Heroku.
SESSION_ID=
AUTO_READ=false
